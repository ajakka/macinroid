<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Macinroid is not sandboxed: it browses the whole disk and talks to the
		phone through the system's USB framework. The network is only used to
		look for updates.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
